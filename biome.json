{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!coverage",
      "!fixtures",
      "!docs/_generated",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": { "preset": "recommended" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
