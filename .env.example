# 管理画面（https://console.typesafe.ai/keys）でキーを発行して貼り付ける。手順: https://docs.typesafe.ai/introduction/quickstart#call-it-the-api
TYPESAFE_API_KEY=

# replay | live | record（未設定なら、キーがあれば live、なければ replay）
# JEV_MODE=replay

# SDK のログ（debug | info | warn | error | off）
# TYPESAFE_LOG_LEVEL=warn

# 表示と質問の言語（ja | en）。英語で進めるなら en / Set to en to take the course in English
# JEV_LANG=en
